---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import GradeCategorias from '../components/GradeCategorias.astro';
import Aviso from '../components/Aviso.astro';
import LocalHorarios from '../components/LocalHorarios.astro';
import IconeWhatsApp from '../components/IconeWhatsApp.astro';
import Botao from '../components/Botao.astro';
import { naFornada } from '../data/produtos';
import { whatsappUrl } from '../data/site';
import { msgFornada } from '../data/mensagens';
---

<Base
  title="Pronta entrega | Pequena Fornalha"
  description="O que sai do forno na fornada da semana e fica no balcão para retirada, sem encomenda, enquanto durar."
>
  <CabecalhoPagina
    eyebrow="A fornada da semana"
    titulo="Pronta entrega"
    resumo="É o que está no balcão nos dias de retirada. Não precisa encomendar: chega, escolhe e leva, enquanto durar. A fornada é pequena e o cardápio muda com a estação."
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <Botao href={whatsappUrl(msgFornada())} externo>
        <IconeWhatsApp slot="icone" class="h-4 w-4" />
        Fazer pedido
      </Botao>
      <Botao href="/encomendas" variante="contorno" seta>Quero garantir por encomenda</Botao>
    </div>
  </CabecalhoPagina>

  <GradeCategorias produtos={naFornada} />

  <div class="mx-auto max-w-[1600px] px-5 pb-20 sm:px-8 sm:pb-24">
    <Aviso titulo="Antes de vir">
      <p>
        Esta lista é o repertório da casa, não uma promessa de estoque. O que entra
        em cada fornada depende da semana. Se você precisa de um pão específico,
        <a href="/encomendas" class="text-terracota underline underline-offset-4 hover:text-melaco">
          encomende
        </a> em vez de arriscar.
      </p>
      <p>
        Quinta e sexta a fornada sai por volta das 16h. Sábado o movimento é maior e
        os doces costumam acabar antes das 11h.
      </p>
      <p>
        Informações de alérgenos estão na página de cada produto e resumidas em{' '}
        <a href="/politicas" class="text-terracota underline underline-offset-4 hover:text-melaco">
          políticas e alérgenos
        </a>.
      </p>
    </Aviso>
  </div>

  <LocalHorarios />
</Base>
