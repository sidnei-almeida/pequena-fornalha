---
import Logomarca from './Logomarca.astro';
import IconeWhatsApp from './IconeWhatsApp.astro';
import Botao from './Botao.astro';
import { navLinks, site, whatsappUrl } from '../data/site';

interface Props {
  /** Na home o header flutua sobre o hero escuro; nas outras páginas fica sólido. */
  sobreposto?: boolean;
}

const { sobreposto = false } = Astro.props;
const caminho = Astro.url.pathname.replace(/\/$/, '') || '/';
const ativo = (href: string) => caminho === href || caminho.startsWith(`${href}/`);
const linkPedido = whatsappUrl();
---

<header
  id="cabecalho"
  data-topo={String(sobreposto)}
  data-sobreposto={String(sobreposto)}
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-500 data-[topo=true]:text-creme data-[topo=false]:bg-creme/95 data-[topo=false]:text-carvao data-[topo=false]:shadow-[0_1px_0_rgba(39,35,31,0.12)] data-[topo=false]:backdrop-blur"
>
  <div class="mx-auto flex h-20 max-w-[1400px] items-center justify-between gap-6 px-5 sm:px-8">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.name}, início`}>
      <Logomarca class="h-11 w-auto" />
      <span class="hidden leading-[1.05] sm:block">
        <span class="block text-[0.95rem] font-bold tracking-[0.16em] uppercase">Pequena</span>
        <span class="block text-[0.95rem] font-bold tracking-[0.16em] uppercase">Fornalha</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-8 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={ativo(link.href) ? 'page' : undefined}
            class:list={[
              'eyebrow relative py-2 transition-opacity after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:bg-current after:transition-transform',
              ativo(link.href)
                ? 'opacity-100 after:scale-x-100'
                : 'opacity-75 hover:opacity-100 after:origin-left after:scale-x-0 hover:after:scale-x-100',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <Botao href={linkPedido} externo class="hidden px-6 py-3 sm:inline-flex">
        <IconeWhatsApp slot="icone" class="h-4 w-4" />
        Fazer pedido
      </Botao>

      <button
        type="button"
        id="abrir-menu"
        aria-controls="menu-mobile"
        aria-expanded="false"
        class="inline-flex h-11 w-11 items-center justify-center rounded-[2px] border border-current/30 lg:hidden"
      >
        <span class="sr-only">Abrir menu</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Menu mobile -->
<div
  id="menu-mobile"
  hidden
  class="fixed inset-0 z-[55] flex flex-col bg-carvao text-creme lg:hidden"
>
  <div class="flex h-20 items-center justify-between px-5 sm:px-8">
    <Logomarca class="h-11 w-auto" />
    <button
      type="button"
      id="fechar-menu"
      class="inline-flex h-11 w-11 items-center justify-center rounded-[2px] border border-creme/30"
    >
      <span class="sr-only">Fechar menu</span>
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav aria-label="Menu" class="flex flex-1 flex-col justify-center gap-2 overflow-y-auto px-5 sm:px-8">
    <a href="/" class="border-b border-creme/15 py-4 font-serif text-3xl" data-fecha-menu>A padaria</a>
    {
      navLinks.map((link) => (
        <a href={link.href} class="border-b border-creme/15 py-4 font-serif text-3xl" data-fecha-menu>
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="p-5 sm:p-8">
    <Botao href={linkPedido} externo variante="claro" class="flex w-full">
      <IconeWhatsApp slot="icone" class="h-5 w-5" />
      Fazer pedido
    </Botao>
  </div>
</div>

<script>
  const cabecalho = document.getElementById('cabecalho')!;
  const menu = document.getElementById('menu-mobile')!;
  const abrir = document.getElementById('abrir-menu')!;
  const fechar = document.getElementById('fechar-menu')!;

  // Só a home tem hero escuro atrás do header: lá ele começa transparente.
  const sobreposto = cabecalho.dataset.sobreposto === 'true';
  if (sobreposto) {
    const atualizaTopo = () => {
      cabecalho.dataset.topo = String(window.scrollY < 40);
    };
    atualizaTopo();
    window.addEventListener('scroll', atualizaTopo, { passive: true });
  }

  const alternaMenu = (aberto: boolean) => {
    menu.hidden = !aberto;
    abrir.setAttribute('aria-expanded', String(aberto));
    document.body.style.overflow = aberto ? 'hidden' : '';
    if (aberto) fechar.focus();
    else abrir.focus();
  };

  abrir.addEventListener('click', () => alternaMenu(true));
  fechar.addEventListener('click', () => alternaMenu(false));
  menu.querySelectorAll('[data-fecha-menu]').forEach((link) =>
    link.addEventListener('click', () => alternaMenu(false)),
  );
  document.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape' && !menu.hidden) alternaMenu(false);
  });
</script>
