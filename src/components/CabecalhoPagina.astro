---
/** Topo padrão das páginas internas: sobrenome da seção, título e resumo. */
interface Props {
  eyebrow: string;
  titulo: string;
  resumo?: string;
  /** Migalhas opcionais, usadas na página de produto. */
  voltar?: { href: string; label: string };
}

const { eyebrow, titulo, resumo, voltar } = Astro.props;
---

<section class="border-b border-carvao/15">
  <div class="mx-auto max-w-[1400px] px-5 pt-32 pb-14 sm:px-8 sm:pt-40 sm:pb-20">
    {
      voltar && (
        <a href={voltar.href} class="eyebrow inline-flex items-center gap-2 text-carvao/55 hover:text-terracota">
          <span aria-hidden="true">←</span>
          {voltar.label}
        </a>
      )
    }

    <p class="eyebrow text-terracota" class:list={[voltar && 'mt-6']}>{eyebrow}</p>
    <h1
      class="mt-4 max-w-[18ch] font-sans text-[clamp(2.2rem,7vw,5rem)] leading-[0.95] font-bold tracking-[-0.02em] uppercase"
    >
      {titulo}
    </h1>
    {resumo && <p class="mt-6 max-w-xl font-serif text-xl leading-relaxed text-carvao/75">{resumo}</p>}
    <slot />
  </div>
</section>
