---
import type { Pergunta } from '../data/faq';

interface Props {
  perguntas: Pergunta[];
}

const { perguntas } = Astro.props;
---

<div class="border-t border-carvao/15">
  {
    perguntas.map((item) => (
      <details class="group border-b border-carvao/15">
        <summary
          class="flex cursor-pointer items-start justify-between gap-6 py-6 font-serif text-xl marker:content-none sm:text-2xl [&::-webkit-details-marker]:hidden"
        >
          {item.pergunta}
          <span
            class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-carvao/25 text-carvao/60 transition-transform group-open:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p class="max-w-2xl pb-7 leading-relaxed text-carvao/70">{item.resposta}</p>
      </details>
    ))
  }
</div>
