---
import Logomarca from './Logomarca.astro';
import IconeWhatsApp from './IconeWhatsApp.astro';
import { footerLinks, site, whatsappUrl } from '../data/site';
import { msgPedido } from '../data/mensagens';

const ano = new Date().getFullYear();
---

{/*
  Três colunas em vez de quatro blocos empilhados, e o endereço subiu para a
  coluna da marca: antes ela tinha só a logo e a linha da tagline, sobrando
  meia coluna de vazio enquanto a de contato descia sozinha com o endereço
  embaixo. Agora as três terminam mais ou menos na mesma altura.

  Os links de navegação vão em duas subcolunas: seis nomes em fila indiana eram
  o que puxava o rodapé para baixo.
*/}
<footer class="bg-carvao text-creme">
  <div class="mx-auto max-w-[1600px] px-5 py-12 sm:px-8 sm:py-14">
    <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1.1fr)_minmax(0,1fr)]">
      {/*
        Em tablet a marca ocupa a linha inteira e deixa Navegar e Contato lado a
        lado embaixo. Sem isso o fluxo do grid jogava o contato para baixo da
        marca, na mesma coluna, e sobrava uma coluna direita pela metade.
      */}
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-3">
          <Logomarca class="h-12 w-auto" />
          <span class="leading-[1.05]">
            <span class="block text-base font-bold tracking-[0.16em] uppercase">Pequena</span>
            <span class="block text-base font-bold tracking-[0.16em] uppercase">Fornalha</span>
          </span>
        </a>
        <p class="eyebrow mt-5 text-creme/50">{site.tagline}</p>
        <p class="mt-5 text-sm leading-relaxed text-creme/55">
          {site.neighborhood}, {site.city}/{site.state}<br />
          {site.addressNote}
        </p>
      </div>

      <nav aria-label="Rodapé">
        <h2 class="eyebrow text-creme/50">Navegar</h2>
        {/* Colunas do tamanho do texto, não do tamanho da célula: com `1fr` a
            segunda fila de links ia parar do outro lado do rodapé. */}
        <ul class="mt-4 grid grid-cols-[auto_auto] justify-start gap-x-12 gap-y-2.5">
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href} class="font-serif text-lg hover:text-terracota">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow text-creme/50">Contato</h2>
        <ul class="mt-4 flex flex-col gap-2.5 font-serif text-lg">
          <li>
            <a
              href={whatsappUrl(msgPedido())}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 hover:text-terracota"
            >
              <IconeWhatsApp class="h-4 w-4" />
              WhatsApp
            </a>
          </li>
          <li>
            <a href={site.instagram} target="_blank" rel="noopener" class="hover:text-terracota">
              {site.instagramHandle}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="hover:text-terracota">{site.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <p class="mt-10 border-t border-creme/12 pt-6 text-xs text-creme/45">
      © {ano} {site.name}. Todos os direitos reservados.
    </p>
  </div>
</footer>
