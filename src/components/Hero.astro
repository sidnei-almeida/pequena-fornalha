---
import Separador from './Separador.astro';
import { heroVideo, site } from '../data/site';
---

<section class="relative flex min-h-[100svh] items-center overflow-hidden bg-carvao text-creme">
  {/*
    Fundo isolado do resto da página: dentro dele, de baixo pra cima, vêm a
    imagem/vídeo, o banho de cor da marca, a vinheta, o degradê que segura a
    leitura do texto e o grão de filme.
  */}
  <div class="hero-fundo absolute inset-0" aria-hidden="true">
    {
      heroVideo.ativo ? (
        <>
          {/* O poster segura o quadro enquanto o vídeo não tem o primeiro frame. */}
          <img
            src={heroVideo.poster}
            alt=""
            class="hero-poster absolute inset-0 h-full w-full object-cover"
            fetchpriority="high"
            decoding="sync"
          />
          <video
            id="video-hero"
            class="hero-video absolute inset-0 h-full w-full object-cover"
            poster={heroVideo.poster}
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            disablepictureinpicture
            tabindex="-1"
          >
            <source src={heroVideo.webm} type="video/webm" />
            <source src={heroVideo.mp4} type="video/mp4" />
          </video>
        </>
      ) : (
        <img
          src={heroVideo.poster}
          alt=""
          class="hero-poster absolute inset-0 h-full w-full object-cover"
          fetchpriority="high"
          decoding="sync"
        />
      )
    }

    <div class="hero-cor absolute inset-0"></div>
    <div class="hero-vinheta absolute inset-0"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-carvao via-carvao/38 to-carvao/55"></div>
    <div class="hero-grao absolute inset-0"></div>
  </div>

  {/*
    Bloco centralizado na altura. O respiro de cima é maior que o de baixo de
    propósito: o header flutua sobre os primeiros 80px do hero, então centro
    geométrico e centro óptico não são o mesmo ponto — sem essa diferença o
    texto parece alto demais.
  */}
  <div
    class="relative mx-auto w-full max-w-[1600px] px-5 pt-28 pb-12 sm:px-8 sm:pt-32 sm:pb-16"
  >
    <p class="eyebrow mb-6 flex items-center gap-2 text-creme/70 sm:mb-8" data-reveal>
      {site.city}
      <Separador />
      {site.state}
      <Separador />
      desde 2024
    </p>

    <h1
      class="titulo-hero max-w-[16ch] font-sans text-[clamp(1.95rem,8.4vw,7.5rem)] leading-[0.95] font-bold tracking-[-0.02em] uppercase"
      data-crescer
    >
      <span class="block"><span class="block">Feito devagar,</span></span>
      <span class="block"><span class="block">feito à mão,</span></span>
      <span class="titulo-hero-italico block font-serif text-terracota normal-case italic">
        <span class="block">feito pra você.</span>
      </span>
    </h1>

    <p
      class="mt-8 max-w-lg border-t border-creme/20 pt-6 font-serif text-lg leading-relaxed text-creme/85 sm:mt-10 sm:pt-8 sm:text-2xl"
      data-reveal
    >
      Padaria de fermentação natural em {site.city}. Fornadas pequenas, três
      dias por semana.
    </p>
  </div>
</section>

{
  heroVideo.ativo && (
    <script>
      const video = document.getElementById('video-hero') as HTMLVideoElement | null;

      if (video) {
        // Em dado limitado ou linha ruim o poster já conta a história: não vale
        // torrar a franquia do visitante com alguns megabytes de fundo.
        const conexao = (navigator as any).connection;
        const linhaRuim =
          conexao &&
          (conexao.saveData === true || /^(slow-2g|2g|3g)$/.test(conexao.effectiveType ?? ''));

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || linhaRuim) {
          // Quem pediu menos movimento — ou está no aperto — fica só com o poster.
          video.removeAttribute('autoplay');
          video.pause();
          video.remove();
        } else {
          // Só revela o vídeo quando há quadro pronto: sem isso pisca preto
          // por cima do poster nos primeiros milissegundos.
          const revelar = () => video.classList.add('esta-pronto');
          if (video.readyState >= 2) revelar();
          else video.addEventListener('loadeddata', revelar, { once: true });

          // No iOS o autoplay às vezes só vale depois que a aba volta ao foco.
          document.addEventListener('visibilitychange', () => {
            if (!document.hidden && video.paused) video.play().catch(() => {});
          });
        }
      }
    </script>
  )
}
