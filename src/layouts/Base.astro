---
import '../styles/global.css';
import { heroVideo, schedule, site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Header flutuando sobre um hero escuro (só a home usa). */
  headerSobreposto?: boolean;
  /**
   * Caminho da imagem de prévia, quando a página tem uma própria — a de
   * produto tem. Precisa ser PNG ou JPG de 1200×630: o WhatsApp descarta SVG e
   * o cartão do link chega sem imagem nenhuma.
   */
  imagem?: string;
  imagemAlt?: string;
}

// A imagem do hero é a primeira coisa que o visitante vê: pedimos ela antes de
// o navegador chegar na tag <img>. Só faz sentido na página que tem hero.

const {
  title = `${site.name} | ${site.tagline}`,
  description = site.description,
  headerSobreposto = false,
  imagem = '/og.png',
  imagemAlt = `${site.name}. ${site.tagline}`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: site.name,
  description: site.description,
  url: new URL('/', Astro.site).href,
  servesCuisine: 'Padaria artesanal',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.state,
    addressCountry: 'BR',
  },
  openingHours: schedule
    .filter((item) => item.hours.includes('às'))
    .map((item) => `${item.day} ${item.hours}`),
  sameAs: [site.instagram],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    {
      headerSobreposto && (
        <link rel="preload" as="image" href={heroVideo.poster} fetchpriority="high" />
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#27231F" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <!-- WhatsApp e redes não renderizam SVG na prévia: aqui vai PNG. -->
    <meta property="og:image" content={new URL(imagem, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imagemAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body class="flex min-h-screen flex-col bg-creme text-carvao antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-[2px] focus:bg-carvao focus:px-5 focus:py-3 focus:text-creme"
    >
      Pular para o conteúdo
    </a>

    <Header sobreposto={headerSobreposto} />
    <main id="conteudo" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
